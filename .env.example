# ===========================================================================
# Arbitrage Bot environment
# Copy this file to .env and fill in your values:  cp .env.example .env
# ===========================================================================
#
# REQUIRED: private key of a DEDICATED BACKUP TRADING WALLET (small balance).
# The bot refuses to run without it and never asks for a seed phrase.
# NEVER use your main / cold wallet. Keep the key inside .env (git-ignored).
#
PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Chains to scan  (comma separated subset of: ethereum,bsc,polygon)
# ---------------------------------------------------------------------------
CHAINS=ethereum,bsc,polygon

# Optional RPC overrides. The host MUST be in the code whitelist
# (settings.ALLOWED_HOSTS) or the bot refuses to start.
# ETHEREUM_RPC=https://eth.llamarpc.com
# BSC_RPC=https://bsc-dataseed1.binance.org
# POLYGON_RPC=https://polygon-rpc.com

# ---------------------------------------------------------------------------
# Trading guardrails
# ---------------------------------------------------------------------------
# Master switch: true = analyze only, never send a transaction.
# Set to false AND pass --live on the command line to actually trade.
DRY_RUN=true

# Maximum USD value per trade (per leg group), and % of the token balance.
TRADE_SIZE_USD=10
MAX_TRADE_PERCENT_OF_BALANCE=20

# Profit floors. A round trip must clear BOTH after real gas costs.
MIN_PROFIT_USD=1.0
MIN_PROFIT_PERCENT=0.6

# Slippage tolerance applied to every swap leg (1% = 0.01).
SLIPPAGE_TOLERANCE=0.01

# Minimum token balance (USD) before a token is considered for trading.
MIN_TOKEN_BALANCE_USD=0.5

# Scan cadence and gas tuning.
SCAN_INTERVAL_SECONDS=15
GAS_PRICE_MULTIPLIER=1.1
GAS_LIMIT_MULTIPLIER=1.2

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO